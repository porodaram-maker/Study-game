# Supabase (프로젝트 설정 → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 서버 전용. 클라이언트 코드에서 절대 쓰지 않는다.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 사이트 주소 (이메일 인증 링크 리다이렉트용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Claude API (서버 전용, 2단계부터 사용)
ANTHROPIC_API_KEY=
AI_MODEL_SMALL=claude-haiku-5-5
AI_MODEL_LARGE=claude-sonnet-5-5

# DB 테스트용 Postgres (npm run test:db). 테스트마다 임시 DB를 만들고 지운다.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
